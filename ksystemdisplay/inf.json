{
  "name": "ksystemdisplay",
  "author": "kriaiss",
  "version": "1.0.3",
  "description": "cool system display monitor",
  "dependencies": [
    "psutil"
  ],
  "settings": [
    "toggle ksystemdisplay"
  ],
  "hotkeys": {
